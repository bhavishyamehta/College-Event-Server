# ── Server ───────────────────────────────────────────────────────────
PORT=8080

# ── MySQL Database ────────────────────────────────────────────────────
DATABASE_TYPE=mysql

# Docker Compose service name (db-mysql) use karna zaroori hai local dev ke liye
# Production (AWS RDS) mein actual RDS endpoint daalo
DB_URL=jdbc:mysql://db-mysql:3306/college_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_DRIVER=com.mysql.cj.jdbc.Driver

# Passwords & Users (Docker Compose ke sath match hona chahiye)
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_ROOT_PASSWORD=your_root_password
DB_POOL_SIZE=10

# ── JWT ───────────────────────────────────────────────────────────────
# Random secret key generate karo (min 32 chars) — production mein strong random value use karo
JWT_SECRET=your_jwt_secret_min_32_characters_long
JWT_ISSUER=college_event
JWT_AUDIENCE=college_event_students
JWT_REALM=college-event-tracker
# Token expiry in milliseconds — 86400000 = 24 hours
JWT_EXPIRATION_MS=86400000

# ── Seeding ───────────────────────────────────────────────────────────
# Keep false on production
SEED_DATABASE=false

# ── Supabase (Storage) ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
STORAGE_BUCKET=your_bucket_name